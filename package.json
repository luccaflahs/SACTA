{
  "name": "projeto-web2",
  "version": "1.0.0",
  "description": "Template do projeto final de Web 2 — API em Express 5",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "predev": "dbmate up",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "prestart": "dbmate up",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:new": "dbmate new",
    "db:up": "dbmate up",
    "db:rollback": "dbmate rollback",
    "db:status": "dbmate status"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "dbmate": "^2.38.2"
  }
}
