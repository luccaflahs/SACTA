{
  "versao": 1, 
  "tema": "SACTA",
  "descricao": "Usuários cadastram livros. Qualquer pessoa vê os livros; só quem cadastrou altera ou remove.",
  "rotas": [
    {
      "metodo": "GET",
      "caminho": "/livros",
      "acesso": "aberto",
      "descricao": "Lista todos os livros.",
      "exemplos": [
        {
          "descricao": "Lista os livros",
          "requisicao": null,
          "resposta": [
            { "id": 1, "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938, "usuarioId": 3 }
          ],
          "status": 200
        }
      ]
    },
    {
      "metodo": "GET",
      "caminho": "/livros/:id",
      "acesso": "aberto",
      "descricao": "Detalha um livro.",
      "exemplos": [
        {
          "descricao": "Livro existe",
          "requisicao": null,
          "resposta": { "id": 1, "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938, "usuarioId": 3 },
          "status": 200
        },
        {
          "descricao": "Livro não existe",
          "requisicao": null,
          "resposta": { "erro": "Livro não encontrado" },
          "status": 404
        }
      ]
    },
    {
      "metodo": "POST",
      "caminho": "/livros",
      "acesso": "logado",
      "descricao": "Cadastra um livro. O dono é quem está logado.",
      "exemplos": [
        {
          "descricao": "Dados válidos",
          "requisicao": { "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938 },
          "resposta": { "id": 1, "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938, "usuarioId": 3 },
          "status": 201
        },
        {
          "descricao": "Falta o autor",
          "requisicao": { "titulo": "Vidas Secas" },
          "resposta": { "erro": "Campo obrigatório ausente: autor" },
          "status": 400
        },
        {
          "descricao": "Sem token",
          "requisicao": { "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938 },
          "resposta": { "erro": "Token ausente ou inválido" },
          "status": 401
        }
      ]
    },
    {
      "metodo": "PUT",
      "caminho": "/livros/:id",
      "acesso": "dono",
      "descricao": "Altera um livro. Só o dono pode.",
      "exemplos": [
        {
          "descricao": "Dono altera o livro",
          "requisicao": { "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938 },
          "resposta": { "id": 1, "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938, "usuarioId": 3 },
          "status": 200
        },
        {
          "descricao": "Ano no futuro",
          "requisicao": { "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 2999 },
          "resposta": { "erro": "Ano não pode ser no futuro" },
          "status": 400
        },
        {
          "descricao": "Sem token",
          "requisicao": { "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938 },
          "resposta": { "erro": "Token ausente ou inválido" },
          "status": 401
        },
        {
          "descricao": "Logado, mas não é o dono",
          "requisicao": { "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938 },
          "resposta": { "erro": "Sem permissão para alterar este livro" },
          "status": 403
        },
        {
          "descricao": "Livro não existe",
          "requisicao": { "titulo": "Vidas Secas", "autor": "Graciliano Ramos", "ano": 1938 },
          "resposta": { "erro": "Livro não encontrado" },
          "status": 404
        }
      ]
    },
    {
      "metodo": "DELETE",
      "caminho": "/livros/:id",
      "acesso": "dono",
      "descricao": "Remove um livro. Só o dono pode.",
      "exemplos": [
        {
          "descricao": "Dono remove o livro",
          "requisicao": null,
          "resposta": null,
          "status": 204
        },
        {
          "descricao": "Sem token",
          "requisicao": null,
          "resposta": { "erro": "Token ausente ou inválido" },
          "status": 401
        },
        {
          "descricao": "Logado, mas não é o dono",
          "requisicao": null,
          "resposta": { "erro": "Sem permissão para remover este livro" },
          "status": 403
        },
        {
          "descricao": "Livro não existe",
          "requisicao": null,
          "resposta": { "erro": "Livro não encontrado" },
          "status": 404
        }
      ]
    }
  ]
}
